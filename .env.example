# Render / Server Environment Variables
PORT=3000

# Supabase (ověřování uživatelů a rolí)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# GitHub API (ukládání Markdown článků a médií)
# Personal Access Token s právem Contents: Read and write pro daný repozitář
GITHUB_TOKEN=ghp_yourPersonalAccessTokenHere
GITHUB_OWNER=jakub
GITHUB_REPO=encyklopedie-picovin
GITHUB_BRANCH=main
GITHUB_CONTENT_DIR=content/articles
GITHUB_MEDIA_DIR=content/media
